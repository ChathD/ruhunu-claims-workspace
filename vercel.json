{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.hosting:app",
      "functions": {
        "backend/hosting.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,tests/**,docs/**,scripts/**,skills/**,.agents/**}"
        },
        "backend/workflow/hosted_jobs.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,tests/**,docs/**,scripts/**,skills/**,.agents/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ]
}
