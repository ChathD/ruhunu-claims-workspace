# Local claims workspace. Policy wording uploads use PDFs.
CLAIMS_DATA_DIR=.local/workspace
# Comma-separated HTTPS origins for a hosted custom domain. Vercel URLs are added automatically.
CLAIMS_ALLOWED_ORIGINS=
# Optional writable directory for downloaded policy models (Vercel uses /tmp).
CLAIMS_MODEL_DIR=
# Enable Supabase mode after importing the local workspace.
# Use the backend-only Session pooler PostgreSQL URI with sslmode=require.
CLAIMS_STORAGE=sqlite
SUPABASE_DATABASE_URL=
# Use v4 for newly queued staff-selected PDF claims after the pilot passes.
CLAIMS_SELECTED_PDF_WORKFLOW=v3

# Optional Langfuse export. Local traces are recorded independently.
CLAIMS_ENABLE_LANGFUSE=1
# Set to 1 in a workspace approved for sending claim and policy text to Langfuse.
CLAIMS_LANGFUSE_CAPTURE_PAYLOADS=1
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional deployment version or commit SHA for trace filtering.
LANGFUSE_RELEASE=

# Loaded by python -m backend. Shell variables take precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# auto enables Claude when a key is present; deterministic disables Claude calls.
CLAIMS_LLM_MODE=auto
# Use streamed Anthropic responses for claim investigations.
CLAIMS_STREAM_MODEL=0

# Required for indexing and searching policy wording with OpenAI embeddings.
OPENAI_API_KEY=
