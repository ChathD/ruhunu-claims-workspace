# Local claims workspace. Product wording uploads support text-based PDF/TXT.
CLAIMS_DATA_DIR=.local/workspace

# Optional Langfuse export. Local traces are recorded independently.
CLAIMS_ENABLE_LANGFUSE=0
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Export exact trace content only from a workspace containing fictional data.
# Leave off for real claims, documents and claim history.
CLAIMS_LANGFUSE_CAPTURE_CONTENT=0

# Loaded by python -m backend. Shell variables take precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# auto enables Claude when a key is present; deterministic disables external calls.
CLAIMS_LLM_MODE=auto
# Use streamed Anthropic responses for claim investigations.
CLAIMS_STREAM_MODEL=0
