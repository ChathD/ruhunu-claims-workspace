        <mxCell id="actors" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#264884;font-weight:700;margin-bottom:5px&quot;&gt;User · Staff · Admin&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Users submit claims and track their own status&lt;br&gt;Staff review evidence and decide claims&lt;br&gt;Admins also generate records and manage accounts&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f4f7ff;strokeColor=#b9c9ef;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="48" y="149" width="518" height="115" as="geometry" /></mxCell>
        <mxCell id="ui" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#264884;font-weight:700;margin-bottom:5px&quot;&gt;React workspace&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Claim portal, dashboards and generator previews&lt;br&gt;Investigation, evidence, audit and reprocessing&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f4f7ff;strokeColor=#b9c9ef;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="646" y="149" width="544" height="115" as="geometry" /></mxCell>
        <mxCell id="api" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#264884;font-weight:700;margin-bottom:5px&quot;&gt;FastAPI&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Session and role checks · REST endpoints · SSE updates&lt;br&gt;Saves submissions, serves audit and queues investigations&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f4f7ff;strokeColor=#b9c9ef;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1271" y="149" width="721" height="115" as="geometry" /></mxCell>
        <mxCell id="manual" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#805320;font-weight:700;margin-bottom:5px&quot;&gt;Manual claim submission&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Claim form and PDF or image attachments&lt;br&gt;Ownership and original evidence saved&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#fffaf2;strokeColor=#e7cfab;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="69" y="394" width="413" height="114" as="geometry" /></mxCell>
        <mxCell id="policy" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#805320;font-weight:700;margin-bottom:5px&quot;&gt;People and policies generator&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Claude creates fictional people and vehicles&lt;br&gt;Comprehensive or third-party schedule&lt;br&gt;Separate wording document linked to policy&lt;br&gt;Saves policy and queues wording indexing&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#fffaf2;strokeColor=#e7cfab;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="69" y="562" width="413" height="154" as="geometry" /></mxCell>
        <mxCell id="synthetic" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#805320;font-weight:700;margin-bottom:5px&quot;&gt;Synthetic claim generator&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Select a saved policy · up to 10 claims per policy&lt;br&gt;Claude plans and drafts a distinct scenario&lt;br&gt;Repair estimates, theft or third-party claims&lt;br&gt;Includes deliberate gaps and cap breaches&lt;br&gt;Review preview before committing&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#fffaf2;strokeColor=#e7cfab;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="69" y="779" width="413" height="178" as="geometry" /></mxCell>
        <mxCell id="assurance" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#264884;font-weight:700;margin-bottom:5px&quot;&gt;Staff controls&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Review the recorded evidence and triage&lt;br&gt;Record approval or rejection with a reason&lt;br&gt;Manual submissions require a staff decision&lt;br&gt;&lt;br&gt;Interrupted attempts expose reprocessing&lt;br&gt;Urgent interrupted cases stay visible to staff&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f4f7ff;strokeColor=#b9c9ef;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="69" y="1048" width="413" height="225" as="geometry" /></mxCell>
        <mxCell id="worker" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Durable local worker&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Runs queued claims and indexes wording&lt;br&gt;Prepares manual evidence before Intake&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="552" y="394" width="414" height="114" as="geometry" /></mxCell>
        <mxCell id="intake" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Mandatory Intake&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Classifies the loss, checks policy ID and duplicates&lt;br&gt;Identifies critical gaps and readiness for Coverage&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1042" y="394" width="455" height="114" as="geometry" /></mxCell>
        <mxCell id="supervisor" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Readiness supervisor&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Claude proposes specialist tasks&lt;br&gt;Python validates dispatch and blockers&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="846" y="565" width="361" height="112" as="geometry" /></mxCell>
        <mxCell id="coverage" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Coverage&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Checks period, vehicle and scope&lt;br&gt;Cross-checks documents and costs&lt;br&gt;Applies schedule and cited wording&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="552" y="736" width="298" height="135" as="geometry" /></mxCell>
        <mxCell id="fraud" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Fraud&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Checks narrative and evidence&lt;br&gt;Groups concerns by severity&lt;br&gt;Follows up on verified history leads&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="873" y="736" width="303" height="135" as="geometry" /></mxCell>
        <mxCell id="history" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Historical comparer&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Runs after confirmed coverage&lt;br&gt;Uses eligible staff-approved claims&lt;br&gt;Compares costs and flags leads&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1199" y="736" width="298" height="135" as="geometry" /></mxCell>
        <mxCell id="collector" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Collector&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Commits findings and evidence by round&lt;br&gt;Updates context for the next dispatch&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="833" y="925" width="387" height="100" as="geometry" /></mxCell>
        <mxCell id="judge" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Judge&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Recommends a route&lt;br&gt;with cited reasons&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="552" y="1100" width="247" height="97" as="geometry" /></mxCell>
        <mxCell id="guard" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:22px;color:#18644c;font-weight:700;margin-bottom:5px&quot;&gt;Python publication guard&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Enforces routing and amount rules&lt;br&gt;Persists triage and human tasks&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5fbf7;strokeColor=#b8d8c9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="874" y="1100" width="328" height="97" as="geometry" /></mxCell>
        <mxCell id="interrupted" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:20px;color:#a13c32;font-weight:700;margin-bottom:5px&quot;&gt;Processing interrupted&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#33454e&quot;&gt;Preserves failed attempt&lt;br&gt;Fresh run on staff retry&lt;br&gt;Alerts for fraud or high value&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#fff4f2;strokeColor=#e9b5ad;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1247" y="1077" width="250" height="120" as="geometry" /></mxCell>
        <mxCell id="route" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:20px;color:#ffffff;font-weight:700;margin-bottom:5px&quot;&gt;Four triage outcomes&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#f0f8f2&quot;&gt;Auto-approve   ·   Adjuster review   ·   Request more information   ·   Fraud escalation&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=5;align=left;verticalAlign=top;fillColor=#164b3e;strokeColor=#164b3e;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="552" y="1242" width="945" height="65" as="geometry" /></mxCell>
        <mxCell id="claude" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#61458f;font-weight:700;margin-bottom:5px&quot;&gt;Anthropic Claude API&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Policy and claim generation&lt;br&gt;Live readiness, specialists and Judge&lt;br&gt;Offline checks use the same LangGraph&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f9f6ff;strokeColor=#d6c8eb;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1571" y="394" width="400" height="128" as="geometry" /></mxCell>
        <mxCell id="extraction" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:22px;color:#61458f;font-weight:700;margin-bottom:5px&quot;&gt;Manual document extraction&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Local PDF text extraction&lt;br&gt;Claude reads image or scanned PDF inputs&lt;br&gt;Structured facts saved beside the original&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f9f6ff;strokeColor=#d6c8eb;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1571" y="568" width="400" height="133" as="geometry" /></mxCell>
        <mxCell id="tools" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#61458f;font-weight:700;margin-bottom:5px&quot;&gt;Scoped LangChain tools&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Load submission and policy schedule&lt;br&gt;Look up duplicates and approved history&lt;br&gt;Search wording and verify evidence&lt;br&gt;Each retrieval is recorded in the audit&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f9f6ff;strokeColor=#d6c8eb;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1571" y="750" width="400" height="149" as="geometry" /></mxCell>
        <mxCell id="rag" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#61458f;font-weight:700;margin-bottom:5px&quot;&gt;Policy wording RAG&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#33454e&quot;&gt;Local MiniLM embeddings and SQLite chunks&lt;br&gt;Generated claims use their linked wording&lt;br&gt;Manual claims use a frozen uploaded corpus&lt;br&gt;Coverage cites applicable passages&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f9f6ff;strokeColor=#d6c8eb;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1571" y="950" width="400" height="164" as="geometry" /></mxCell>
        <mxCell id="limits" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:24px;color:#264884;font-weight:700;margin-bottom:5px&quot;&gt;Processing controls&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#33454e&quot;&gt;Up to four dispatch rounds after Intake&lt;br&gt;Coverage gates can stop Historical early&lt;br&gt;Technical failures pause route publication&lt;br&gt;Gross over LKR 250,000 needs human oversight&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f4f7ff;strokeColor=#b9c9ef;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1571" y="1161" width="400" height="134" as="geometry" /></mxCell>
        <mxCell id="db" value="&lt;div style=&quot;font-family:Segoe UI;text-align:left;line-height:1.24&quot;&gt;&lt;div style=&quot;font-size:21px;color:#305a7d;font-weight:700;margin-bottom:5px&quot;&gt;claims.sqlite3&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#33454e&quot;&gt;Submissions, accounts, policies, wording and uploads&lt;br&gt;Findings, model and tool calls, routes, staff decisions and retry links&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;spacing=0;spacingLeft=16;spacingRight=13;spacingTop=11;align=left;verticalAlign=top;fillColor=#f5faff;strokeColor=#bfd2e5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="68" y="1410" width="581" height="106" as="geometry" /></mxCell>
